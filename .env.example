# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_MINI_APP_URL=https://your-app-url.com

# Ozon API Configuration
# Note: User-specific credentials will be stored encrypted in database
# OZON_CLIENT_ID=your_client_id
# OZON_API_KEY=your_api_key

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ozon_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=your_secret_key_for_encryption
ENCRYPTION_KEY=your_encryption_key_for_api_keys

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Environment
ENV=development
DEBUG=True

# Sentry (optional)
SENTRY_DSN=
